# ─── etcd ────────────────────────────────────────────────────────────────────
# How to locate the client certificates: kubeadm | kubespray | explicit
ETCD_MODE=kubeadm
# ETCD_MODE=kubespray
# ETCD_ENV_FILE=/etc/etcd.env
# ETCD_MODE=explicit then requires all four:
# ETCDCTL_ENDPOINTS=https://127.0.0.1:2379
# ETCDCTL_CACERT=/path/ca.crt
# ETCDCTL_CERT=/path/server.crt
# ETCDCTL_KEY=/path/server.key

# ─── Object storage ──────────────────────────────────────────────────────────
# Credentials, region and endpoint use the AWS CLI's own variables — the image
# does not read or rewrite them. Leave them unset to fall back to an EC2
# instance role or an EKS service account (IRSA).
AWS_ACCESS_KEY_ID=your_access_key
AWS_SECRET_ACCESS_KEY=your_secret_key
AWS_REGION=us-east-1
# Required for MinIO / Ceph / R2 / Spaces. Omit for real AWS.
AWS_ENDPOINT_URL_S3=https://minio.example.com

# Read by this image (not by the AWS CLI).
# Leave S3_BUCKET empty to keep backups on the local volume only.
S3_BUCKET=your-bucket
S3_PREFIX=backups/etcd

# ─── Retention ───────────────────────────────────────────────────────────────
# Counts, not days: keep the N newest runs on each side, 0 disables pruning.
# Note this couples the retention window to SCHEDULE — backing up every hour
# instead of every four shortens how far back KEEP_REMOTE reaches.
KEEP_LOCAL=3
KEEP_REMOTE=30

# ─── Schedule ────────────────────────────────────────────────────────────────
# Cron expression for the in-container scheduler. Empty = run once and exit.
#   0 */4 * * *   every 4 hours        0 2 * * *   daily at 02:00 UTC
#   @hourly       every hour          @daily      every day at midnight
SCHEDULE=

# ─── Notifications ───────────────────────────────────────────────────────────
# A channel is enabled by its own variables being set; several can run at once.
# A channel that fails is logged and skipped — it never changes the outcome of
# a backup.
#
# NOTIFY_ON:  never   nothing
#             change  transitions only: the first failure, and the recovery
#             failure every failure, plus the recovery (default)
#             always  every run
NOTIFY_ON=failure

# NOTIFY_SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...
# NOTIFY_GOOGLE_CHAT_WEBHOOK_URL=https://chat.googleapis.com/v1/spaces/...
# NOTIFY_DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...
# NOTIFY_TELEGRAM_BOT_TOKEN=123456:ABC...
# NOTIFY_TELEGRAM_CHAT_ID=-1001234567890
# Structured JSON, for n8n / Alertmanager / your own service.
# NOTIFY_WEBHOOK_URL=https://hooks.internal/backup
# Email over SMTP, using curl — no extra dependency.
# NOTIFY_SMTP_URL=smtps://user:password@smtp.example.com:465
# NOTIFY_SMTP_FROM=backup@example.com
# NOTIFY_SMTP_TO=ops@example.com          # comma-separated for several
# NOTIFY_TIMEOUT=15

# ─── Health ──────────────────────────────────────────────────────────────────
# Seconds since the last successful backup before the container reports
# unhealthy. 0 (default) only reports the last run's outcome, which cannot
# notice a schedule that quietly stopped firing.
# HEALTHCHECK_MAX_AGE=0

# ─── Misc ────────────────────────────────────────────────────────────────────
# MODE=backup (default) | fetch | restore
# DRY_RUN=true logs what would happen without writing or deleting anything.
# RESTORE_TIMESTAMP pins a run (YYYYMMDD_HHMMSS); empty selects the newest.
# This image supports MODE=fetch but not MODE=restore: an etcd restore
# rewrites the data directory of a stopped member. See docs/backends/etcd.md.
